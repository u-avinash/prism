# =============================================================================
# PRISM demo-suite configuration
# =============================================================================
# Copy this file to demo/.env and replace values for your environment.
# Do not commit demo/.env or any real credentials.

# PRISM's OTLP/HTTP receiver. Demo applications send telemetry to the collector;
# the collector forwards it to PRISM.
PRISM_INGESTION_ENDPOINT=http://host.docker.internal:8000
PRISM_OTLP_EXPORT_API_KEY=REPLACE_WITH_PROJECT_API_KEY

# Project metadata used by the demo telemetry and intended PRISM project setup.
PRISM_DEMO_PROJECT_NAME=prism-capabilities-demo
PRISM_DEMO_ENVIRONMENT=demo
PRISM_DEMO_REPOSITORY_URL=https://github.com/your-org/prism-capabilities-demo
PRISM_DEMO_REPOSITORY_BRANCH=main

# ---------------------------------------------------------------------------
# Populate the following only when preparing the external-integration demo.
# Leaving them blank allows ingestion, incident generation, RCA, and UI demos.
# ---------------------------------------------------------------------------
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

SLACK_WEBHOOK_URL=

ANYPOINT_PLATFORM_CLIENT_ID=
ANYPOINT_PLATFORM_CLIENT_SECRET=
ANYPOINT_ORG_ID=
ANYPOINT_ENVIRONMENT=
